# ---------------------------------------------------------------------------
# Rust / Cargo
# ---------------------------------------------------------------------------
# Compiled output for every workspace: rust/, cli/ and both fuzz crates. A bare `target/` matches
# any directory of that name at any depth.
target/

# rust/ is a library: it resolves against whatever a consumer already has, so a lock file would be
# a claim it cannot keep.
Cargo.lock

# cli/ ships a binary, so its lock files are committed: they make a release build reproducible,
# and cargo-deny and Renovate act on them.
!/cli/Cargo.lock
!/cli/fuzz/Cargo.lock

# Backup files emitted by `rustfmt`.
**/*.rs.bk

# The report a local `cargo mutants` run writes. It is machine output, replaced on every run.
mutants.out/
mutants.out.old/

# MSVC debug symbols.
*.pdb

# ---------------------------------------------------------------------------
# Java / Gradle
# ---------------------------------------------------------------------------
# Compiled output for every module under java/. A bare `build/` matches any directory of that
# name at any depth.
build/
# Gradle's per-project cache. The wrapper jar under gradle/wrapper/ is committed: it is how CI
# and a fresh clone get the pinned Gradle version without a local install.
.gradle/

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
# Bytecode the reference producer under spec/v1/producers/python/ leaves behind when run.
__pycache__/

# ---------------------------------------------------------------------------
# Environment & secrets (never commit these)
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
# Any `*.env` file, wherever it lives. The patterns above match only files *named* `.env…`,
# so a file such as `deploy/local.env` would otherwise be tracked by accident. Ship
# `*.env.example` instead.
*.env
!*.env.example

# ---------------------------------------------------------------------------
# IDE / editor metadata
# ---------------------------------------------------------------------------
.idea/
.vscode/
*.iml
*.swp
*.swo
*~

# ---------------------------------------------------------------------------
# Agent tooling caches
# ---------------------------------------------------------------------------
.serena/cache/
.serena/*.local.yml
.junie/tools

# ---------------------------------------------------------------------------
# Logs & OS files
# ---------------------------------------------------------------------------
*.log
.DS_Store
Thumbs.db
desktop.ini
