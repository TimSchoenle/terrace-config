<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
        "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
        "https://checkstyle.org/dtds/configuration_1_3.dtd">

<!--
  Applied to every module's test sources (checkstyleTest) by `terrace-config.java-conventions` —
  deliberately lighter than checkstyle.xml (checkstyleMain's ruleset), not a copy of it. See
  java/README.md's "Static analysis" section for why test code gets its own, narrower bar:
  correctness- and readability-oriented checks stay on, but the design/finality/Javadoc rules
  written for a published API (FinalClass, HideUtilityClassConstructor, VisibilityModifier,
  FinalParameters, FinalLocalVariable, MissingJavadocType) are dropped rather than forced onto
  `@TempDir`-holding fixtures, JUnit's own package-private no-arg-constructor test classes, and
  throwaway locals a test builds up step by step for readability.

  toolVersion is pinned in gradle/libs.versions.toml (`checkstyle`); bump both together with
  checkstyle.xml.
-->
<module name="Checker">
    <property name="severity" value="error"/>
    <property name="fileExtensions" value="java"/>

    <module name="SuppressWarningsFilter"/>

    <module name="NewlineAtEndOfFile"/>
    <module name="FileTabCharacter">
        <property name="eachLine" value="true"/>
    </module>
    <module name="LineLength">
        <property name="max" value="120"/>
    </module>

    <module name="TreeWalker">
        <module name="SuppressWarningsHolder"/>

        <!-- ============================== Imports ============================== -->
        <!-- NOT enabled: CustomImportOrder/ImportOrder — see checkstyle.xml's Imports section for
             why (it mismatches Spotless's own static-import placement, which is what actually
             governs import grouping here). -->
        <module name="AvoidStarImport"/>
        <module name="RedundantImport"/>
        <module name="UnusedImports">
            <property name="processJavadoc" value="true"/>
        </module>

        <!-- ============================== Naming ============================== -->
        <module name="TypeName"/>
        <!-- Relaxed from checkstyleMain's camelCase-only default: this codebase's own test-naming
             convention is a snake_case sentence describing the scenario (e.g.
             `a_file_suffixed_variable_supplies_the_property_its_target_names`), not a verb phrase
             — far more readable in a test report than the camelCase equivalent, and this is the
             one place that convention actually lives, so the naming check is adjusted to it rather
             than the other way around. -->
        <module name="MethodName">
            <property name="format" value="^[a-z][a-zA-Z0-9_]*$"/>
        </module>
        <module name="MemberName"/>
        <module name="ParameterName"/>
        <module name="LambdaParameterName"/>
        <module name="CatchParameterName"/>
        <module name="LocalVariableName"/>
        <module name="ConstantName"/>
        <module name="StaticVariableName"/>
        <module name="PackageName">
            <property name="format" value="^[a-z]+(\.[a-z][a-z0-9]*)*$"/>
        </module>

        <!-- ============================== Design ============================== -->
        <module name="OneTopLevelClass"/>
        <module name="MutableException"/>

        <!-- ============================== Coding ============================== -->
        <module name="EqualsHashCode"/>
        <module name="EqualsAvoidNull"/>
        <module name="CovariantEquals"/>
        <module name="MultipleVariableDeclarations"/>
        <module name="OneStatementPerLine"/>
        <module name="SimplifyBooleanExpression"/>
        <module name="StringLiteralEquality"/>
        <module name="PackageDeclaration"/>
        <module name="FallThrough"/>
        <module name="DefaultComesLast"/>
        <module name="ArrayTypeStyle"/>
        <module name="UpperEll"/>
        <module name="OuterTypeFilename"/>

        <!-- ============================== Blocks ============================== -->
        <module name="EmptyBlock">
            <property name="option" value="text"/>
        </module>
        <module name="NeedBraces"/>

        <!-- ============================== Modifiers ============================== -->
        <module name="ModifierOrder"/>
        <module name="RedundantModifier"/>

        <!-- ============================== Sizes ============================== -->
        <!-- Higher than checkstyleMain's 150: a real integration test (e.g.
             OrdersServiceFileIndirectionIntegrationTest) legitimately walks through several
             setup/exercise/assert phases in one @Test method, and splitting it up for this limit
             alone would cost more clarity than it buys. -->
        <module name="MethodLength">
            <property name="max" value="300"/>
        </module>
        <module name="ParameterNumber">
            <property name="max" value="8"/>
        </module>
    </module>
</module>
