# Picked up by Lombok itself (not Gradle) by walking up from each source file's directory, so
# this one file governs every module under java/ — including the empty ones once they gain
# sources. `config.stopBubbling` keeps that search from continuing past this directory into the
# repository root, which has no Java code and should never need a Lombok opinion.
config.stopBubbling = true

# Marks every Lombok-generated method/constructor with `@Generated`, which JaCoCo (and most other
# coverage/static-analysis tools) already know to exclude — so line coverage on a `@Data` class
# reports on the hand-written code only, not the boilerplate Lombok wrote for it.
lombok.addLombokGeneratedAnnotation = true

# `@EqualsAndHashCode`/`@ToString` on a subclass silently ignoring the superclass's fields is a
# common Lombok footgun; fail the build instead of guessing.
lombok.equalsAndHashCode.callSuper = call
lombok.toString.callSuper = call

# Matches what every class in the repo already writes out by hand; doesn't presuppose whether a
# given model class ends up immutable (`@Value`) or not — that's a per-class decision for PR 4
# onward, not one to bake into every module's shared config.
lombok.fieldDefaults.defaultPrivate = true

# No module here needs Lombok's own logging annotations (@Slf4j and friends) today; keep them off
# rather than have one show up by accident and add a logging-framework dependency nobody chose.
lombok.log.fieldName = LOG
lombok.log.custom.flagUsage = ERROR
