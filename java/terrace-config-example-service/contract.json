          "trace",
          "debug",
          "info",
          "warn"
        ],
        "type": "string"
      },
      "port": {
        "description": "Port the HTTP listener binds to.",
        "type": "integer"
      }
    },
    "title": "orders-service configuration",
    "type": "object"
