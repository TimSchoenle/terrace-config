{
  "terrace_contract": 1,
  "producer": {
    "name": "terrace-config-java",
    "version": "0.0.0-conformance",
    "loader": "terrace-java"
  },
  "app": {
    "name": "site",
    "version": "1.0.0"
  },
  "schema": {
    "schema_version": 2,
    "dialect": {
      "prefix": "SITE_",
      "nesting_separator": "__",
      "indirection_suffix": "_FILE"
    },
    "loader": [
      {
        "env": "SITE_CONFIG",
        "role": "config",
        "docs": "Names the TOML layer: a file, or a directory whose *.toml files are all merged in name order.",
        "default": "config.toml"
      },
      {
        "env": "SITE_SECRETS_DIR",
        "role": "secrets_dir",
        "docs": "Names a directory of key-named files -- a mounted Kubernetes Secret volume. Each file supplies the key its name spells.",
        "default": null
      }
    ],
    "keys": [
      {
        "path": "dist_dir",
        "env": "SITE_DIST_DIR",
        "env_file": "SITE_DIST_DIR_FILE",
        "secrets_file": "dist_dir",
        "docs": "Bundle directory the readiness probe checks.",
        "ty": "String",
        "values": [],
        "constraint": {
          "type": "string"
        },
        "text_form": "text",
        "aliases": [],
        "env_aliases": [],
        "env_file_aliases": [],
        "secrets_file_aliases": [],
        "default": "public",
        "default_value": "public",
        "note": null,
        "required": false,
        "secret": false,
        "reserved": false
      },
      {
        "path": "legal.documents",
        "env": "SITE_LEGAL__DOCUMENTS",
        "env_file": "SITE_LEGAL__DOCUMENTS_FILE",
        "secrets_file": "legal__documents",
        "docs": "Legal documents, by the name the site links them under.",
        "ty": "Map<String,String>",
        "values": [],
        "constraint": {
          "required": [
            "imprint",
            "privacy"
          ],
          "type": "object"
        },
        "text_constraint": {
          "pattern": "^\\s*[\\[\\{][\\s\\S]*[\\]\\}]\\s*$",
          "type": "string"
        },
        "text_form": "structured",
        "aliases": [],
        "env_aliases": [],
        "env_file_aliases": [],
        "secrets_file_aliases": [],
        "default": null,
        "default_value": null,
        "note": null,
        "required": true,
        "secret": false,
        "reserved": false
      },
      {
        "path": "legal.links",
        "env": "SITE_LEGAL__LINKS",
        "env_file": "SITE_LEGAL__LINKS_FILE",
        "secrets_file": "legal__links",
        "docs": "Footer links, by label.",
        "ty": "Map<String,String>",
        "values": [],
        "constraint": {
          "required": [
            "home"
          ],
          "type": "object"
        },
        "text_constraint": {
          "pattern": "^\\s*[\\[\\{][\\s\\S]*[\\]\\}]\\s*$",
          "type": "string"
        },
        "text_form": "structured",
        "aliases": [],
        "env_aliases": [],
        "env_file_aliases": [],
        "secrets_file_aliases": [],
        "default": "{ home = / }",
        "default_value": {
          "home": "/"
        },
        "note": null,
        "required": false,
        "secret": false,
        "reserved": false
      }
    ]
  },
  "json_schema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "additionalProperties": false,
    "properties": {
      "dist_dir": {
        "default": "public",
        "description": "Bundle directory the readiness probe checks.",
        "type": "string"
      },
      "legal": {
        "additionalProperties": false,
        "properties": {
          "documents": {
            "description": "Legal documents, by the name the site links them under.",
            "required": [
              "imprint",
              "privacy"
            ],
            "type": "object"
          },
          "links": {
            "default": {
              "home": "/"
            },
            "description": "Footer links, by label.",
            "required": [
              "home"
            ],
            "type": "object"
          }
        },
        "type": "object"
      }
    },
    "title": "site configuration",
    "type": "object"
  },
  "external": {
    "env": [],
    "ignore": [],
    "unknown": "reject"
  }
}
