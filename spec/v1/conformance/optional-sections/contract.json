{
  "terrace_contract": 1,
  "producer": {
    "name": "terrace-config",
    "version": "0.0.0-conformance",
    "loader": "figment"
  },
  "app": {
    "name": "limiter",
    "version": "1.0.0"
  },
  "schema": {
    "schema_version": 2,
    "dialect": {
      "prefix": "LIMITER_",
      "nesting_separator": "__",
      "indirection_suffix": "_FILE"
    },
    "loader": [
      {
        "env": "LIMITER_CONFIG",
        "role": "config",
        "docs": "Names the TOML layer: a file, or a directory whose `*.toml` files are all merged in name order.",
        "default": "config.toml"
      },
      {
        "env": "LIMITER_SECRETS_DIR",
        "role": "secrets_dir",
        "docs": "Names a directory of key-named files — a mounted Kubernetes `Secret` volume. Each file supplies the key its name spells.",
        "default": null
      }
    ],
    "keys": [
      {
        "path": "global.per_minute",
        "env": "LIMITER_GLOBAL__PER_MINUTE",
        "env_file": "LIMITER_GLOBAL__PER_MINUTE_FILE",
        "secrets_file": "global__per_minute",
        "docs": "Requests allowed per minute, which is the bucket's refill rate.",
        "ty": "u32",
        "values": [],
        "constraint": {
          "maximum": 4294967295,
          "minimum": 0,
          "type": "integer"
        },
        "text_constraint": {
          "pattern": "^\\s*\\+?[0-9]+\\s*$",
          "type": "string"
        },
        "text_form": "integer",
        "aliases": [],
        "env_aliases": [],
        "env_file_aliases": [],
        "secrets_file_aliases": [],
