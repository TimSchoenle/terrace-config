{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "auth": {
      "additionalProperties": false,
      "properties": {
        "burst": {
          "description": "The most requests a client may spend back-to-back.",
          "maximum": 4294967295,
          "minimum": 0,
          "type": "integer"
        },
        "per_minute": {
          "description": "Requests allowed per minute, which is the bucket's refill rate.",
          "maximum": 4294967295,
          "minimum": 0,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "global": {
      "additionalProperties": false,
      "properties": {
        "burst": {
          "default": 60,
          "description": "The most requests a client may spend back-to-back.",
          "maximum": 4294967295,
          "minimum": 0,
          "type": "integer"
        },
        "per_minute": {
          "default": 300,
          "description": "Requests allowed per minute, which is the bucket's refill rate.",
          "maximum": 4294967295,
          "minimum": 0,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "store": {
      "additionalProperties": false,
      "properties": {
        "url": {
          "description": "Connection URL of the counter store.",
          "type": "string"
        }
      },
      "required": [
        "url"
      ],
      "type": "object"
    }
  },
  "required": [
    "store"
  ],
  "type": "object"
}
