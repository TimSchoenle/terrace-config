{
  "terrace_contract": 1,
  "producer": {
    "name": "example-producer",
    "version": "0.0.0-conformance",
    "loader": "figment"
  },
  "app": {
    "name": "schema-version-1",
    "version": "1.0.0"
  },
  "schema": {
    "schema_version": 1,
    "dialect": {
      "prefix": "LEGACY_",
      "nesting_separator": "__",
      "indirection_suffix": "_FILE"
    },
    "loader": [
      {
        "env": "LEGACY_CONFIG",
        "role": "config",
        "docs": "Names the TOML layer.",
        "default": "config.toml"
      },
      {
        "env": "LEGACY_SECRETS_DIR",
        "role": "secrets_dir",
        "docs": "Names a directory of key-named files.",
        "default": null
      }
    ],
    "keys": [
      {
        "path": "peers",
        "env": "LEGACY_PEERS",
        "env_file": "LEGACY_PEERS_FILE",
        "secrets_file": "peers",
        "docs": "Callers allowed to reach the internal API, by name.",
        "ty": "Map",
        "values": [],
        "constraint": {
          "type": "object"
        },
        "text_form": "structured",
        "aliases": [],
        "env_aliases": [],
        "env_file_aliases": [],
        "secrets_file_aliases": [],
        "default": null,
        "default_value": null,
        "note": null,
        "required": false,
        "secret": false,
        "reserved": false
      },
      {
        "path": "methods",
        "env": "LEGACY_METHODS",
        "env_file": "LEGACY_METHODS_FILE",
        "secrets_file": "methods",
        "docs": "HTTP methods the proxy forwards.",
        "ty": "Vec",
        "values": [],
        "constraint": {
          "type": "array"
        },
        "text_form": "structured",
        "aliases": [],
        "env_aliases": [],
        "env_file_aliases": [],
        "secrets_file_aliases": [],
        "default": null,
        "default_value": null,
        "note": null,
        "required": false,
        "secret": false,
        "reserved": false
      },
      {
        "path": "dist_dir",
        "env": "LEGACY_DIST_DIR",
        "env_file": "LEGACY_DIST_DIR_FILE",
        "secrets_file": "dist_dir",
        "docs": "Bundle directory the readiness probe checks.",
        "ty": "String",
        "values": [],
        "constraint": {
          "type": "string"
        },
        "text_form": "text",
        "aliases": [],
        "env_aliases": [],
        "env_file_aliases": [],
        "secrets_file_aliases": [],
        "default": "public",
        "default_value": "public",
        "note": null,
        "required": false,
        "secret": false,
        "reserved": false
      }
    ]
  },
  "json_schema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "additionalProperties": false,
    "properties": {
      "dist_dir": {
        "default": "public",
        "description": "Bundle directory the readiness probe checks.",
        "type": "string"
      },
      "methods": {
        "description": "HTTP methods the proxy forwards.",
        "type": "array"
      },
      "peers": {
        "description": "Callers allowed to reach the internal API, by name.",
        "type": "object"
      }
    },
    "title": "schema-version-1 configuration",
    "type": "object"
  },
  "external": {
    "env": [],
    "ignore": [],
    "unknown": "reject"
  }
}
